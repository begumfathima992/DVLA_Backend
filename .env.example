NODE_ENV=development
PORT=5000
API_PREFIX=/api

# Comma-separated frontend origins. Use * only during local development.
CORS_ORIGIN=http://localhost:5173,https://prestigeworkshops.com,https://www.prestigeworkshops.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prestigeworkshops
DB_USER=prestigeworkshops
DB_PASSWORD=change_me
DB_LOGGING=false

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
ALLOW_PUBLIC_REGISTRATION=false

DVLA_URL=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles
DVLA_API_KEY=your_dvla_api_key
